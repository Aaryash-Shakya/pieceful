extends RefCounted
## Renders the six placeholder pictures from fixed recipes, so the committed collection can be regenerated.
## Every layout value is a fraction of the long edge, so a small render has the same layout as a large one.

const LONG_EDGE := 2048
const THUMB_LONG_EDGE := 256
const WEBP_QUALITY := 0.8
const CREDIT := "Aaryash Shakya, generated by tools/make_collection.gd"
const LICENCE := "CC-BY-4.0"

const GRAIN_AMOUNT := 0.15
const GRAIN_FEATURE_DIVISOR := 170.0
## Brightness-independent share of the grain, so dark regions keep texture too.
const GRAIN_LIFT := 0.5
const TINT_AMOUNT := 0.06

const SPECS: Array[Dictionary] = [
	{"slug": "ember-rings", "title": "Ember Rings", "aspect": Vector2i(3, 2), "motif": "rings", "seed": 1597334677},
	{"slug": "stained-glass", "title": "Stained Glass", "aspect": Vector2i(2, 3), "motif": "cells", "seed": 668265263},
	{"slug": "tide-stripes", "title": "Tide Stripes", "aspect": Vector2i(1, 1), "motif": "stripes", "seed": 374761393},
	{"slug": "confetti-field", "title": "Confetti Field", "aspect": Vector2i(4, 3), "motif": "confetti", "seed": 1640531527},
	{"slug": "prism-mosaic", "title": "Prism Mosaic", "aspect": Vector2i(16, 9), "motif": "mosaic", "seed": 1013904223},
	{"slug": "woven-plaid", "title": "Woven Plaid", "aspect": Vector2i(9, 16), "motif": "plaid", "seed": 1103515245},
]


static func size_for(aspect: Vector2i, long_edge: int) -> Vector2i:
	var long_side := maxi(aspect.x, aspect.y)
	var short_side := roundi(long_edge * mini(aspect.x, aspect.y) / float(long_side))
	if aspect.x >= aspect.y:
		return Vector2i(long_edge, short_side)
	return Vector2i(short_side, long_edge)


static func manifest(collection_id: String, title: String, long_edge: int) -> Dictionary:
	var pictures: Array[Dictionary] = []
	for spec in SPECS:
		var size := size_for(spec.aspect, long_edge)
		pictures.append({
			"id": "%s-%s" % [collection_id, spec.slug],
			"title": spec.title,
			"file": "%s.webp" % spec.slug,
			"width": size.x,
			"height": size.y,
			"credit": CREDIT,
			"licence": LICENCE,
			"generated": true,
		})
	return {"id": collection_id, "title": title, "pictures": pictures}


static func render(spec: Dictionary, size: Vector2i) -> Image:
	var rng := SeededRng.new(spec.seed)
	var palette := _palette(rng)
	var long_side := float(maxi(size.x, size.y))
	var count := size.x * size.y
	var buf := PackedFloat32Array()
	buf.resize(count * 3)

	var grain_noise := FastNoiseLite.new()
	grain_noise.seed = spec.seed
	grain_noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	grain_noise.fractal_type = FastNoiseLite.FRACTAL_FBM
	grain_noise.fractal_octaves = 3
	grain_noise.frequency = GRAIN_FEATURE_DIVISOR / long_side
	var grain := grain_noise.get_image(size.x, size.y, false, false, true).get_data()

	var drift_noise := FastNoiseLite.new()
	drift_noise.seed = spec.seed + 7
	drift_noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	drift_noise.frequency = 2.5 / long_side
	var drift := drift_noise.get_image(size.x, size.y, false, false, true).get_data()

	match spec.motif:
		"rings":
			_rings(buf, size, rng, palette)
		"cells":
			_cells(buf, size, rng, palette)
		"stripes":
			_stripes(buf, size, rng, palette, drift)
		"confetti":
			_confetti(buf, size, rng, palette)
		"mosaic":
			_mosaic(buf, size, rng, palette)
		"plaid":
			_plaid(buf, size, rng, palette)

	var data := PackedByteArray()
	data.resize(count * 3)
	for i in count:
		var g := 1.0 + (grain[i] / 255.0 - 0.5) * 2.0 * GRAIN_AMOUNT
		var t := (drift[i] / 255.0 - 0.5) * 2.0 * TINT_AMOUNT
		var o := i * 3
		var lift := (g - 1.0) * GRAIN_LIFT
		data[o] = clampi(roundi((buf[o] * g * (1.0 + t) + lift) * 255.0), 0, 255)
		data[o + 1] = clampi(roundi((buf[o + 1] * g + lift) * 255.0), 0, 255)
		data[o + 2] = clampi(roundi((buf[o + 2] * g * (1.0 - t) + lift) * 255.0), 0, 255)
	return Image.create_from_data(size.x, size.y, false, Image.FORMAT_RGB8, data)


## Six colours spread around the hue wheel, so neighbouring regions differ in hue and not only in brightness.
static func _palette(rng: SeededRng) -> Array[Color]:
	var colors: Array[Color] = []
	var start := rng.next_float()
	for i in 6:
		var hue := fposmod(start + i / 6.0 + rng.range_float(-0.03, 0.03), 1.0)
		colors.append(Color.from_hsv(hue, rng.range_float(0.5, 0.95), rng.range_float(0.45, 0.95)))
	return colors


static func _shade(c: Color, factor: float) -> Color:
	return Color(minf(c.r * factor, 1.0), minf(c.g * factor, 1.0), minf(c.b * factor, 1.0))


static func _put(buf: PackedFloat32Array, index: int, c: Color) -> void:
	var o := index * 3
	buf[o] = c.r
	buf[o + 1] = c.g
	buf[o + 2] = c.b


static func _fill(buf: PackedFloat32Array, c: Color) -> void:
	for o in range(0, buf.size(), 3):
		buf[o] = c.r
		buf[o + 1] = c.g
		buf[o + 2] = c.b


## Overlapping sets of concentric rings over a dark base; later sets cover earlier ones.
static func _rings(buf: PackedFloat32Array, size: Vector2i, rng: SeededRng, palette: Array[Color]) -> void:
	var long_side := float(maxi(size.x, size.y))
	var ax := size.x / long_side
	var ay := size.y / long_side
	_fill(buf, _shade(palette[0], 0.5))
	for s in 5:
		var cx := rng.range_float(0.1, ax - 0.1) * long_side
		var cy := rng.range_float(0.1, ay - 0.1) * long_side
		var ring_width := rng.range_float(0.03, 0.045) * long_side
		var rings := rng.range_int(5, 7)
		var offset := rng.range_int(0, 5)
		var radius := rings * ring_width
		var x0 := maxi(int(cx - radius), 0)
		var x1 := mini(int(cx + radius) + 1, size.x)
		var y0 := maxi(int(cy - radius), 0)
		var y1 := mini(int(cy + radius) + 1, size.y)
		var colors: Array[Color] = []
		for k in rings:
			colors.append(_shade(palette[(offset + k) % 6], 0.75 + 0.25 * (k % 2)))
		for y in range(y0, y1):
			var dy := y - cy
			for x in range(x0, x1):
				var dx := x - cx
				var d := sqrt(dx * dx + dy * dy)
				if d < radius:
					_put(buf, y * size.x + x, colors[int(d / ring_width)])


## Voronoi cells from a jittered grid, with dark leading where two cells are nearly equidistant.
static func _cells(buf: PackedFloat32Array, size: Vector2i, rng: SeededRng, palette: Array[Color]) -> void:
	var long_side := float(maxi(size.x, size.y))
	var gx := maxi(1, roundi(size.x / long_side * 9.0))
	var gy := maxi(1, roundi(size.y / long_side * 9.0))
	var cw := float(size.x) / gx
	var ch := float(size.y) / gy
	var px := PackedFloat32Array()
	var py := PackedFloat32Array()
	var colors: Array[Color] = []
	for j in gy:
		for i in gx:
			px.append((i + rng.range_float(0.15, 0.85)) * cw)
			py.append((j + rng.range_float(0.15, 0.85)) * ch)
			colors.append(_shade(palette[rng.range_int(0, 5)], rng.range_float(0.6, 1.2)))
	var lead := 0.008 * long_side
	var leading := Color(0.16, 0.12, 0.15)
	for y in size.y:
		var cj := int(y / ch)
		for x in size.x:
			var ci := int(x / cw)
			var d1 := INF
			var d2 := INF
			var best := 0
			for nj in range(maxi(cj - 1, 0), mini(cj + 2, gy)):
				for ni in range(maxi(ci - 1, 0), mini(ci + 2, gx)):
					var n := nj * gx + ni
					var dx := x - px[n]
					var dy := y - py[n]
					var d := dx * dx + dy * dy
					if d < d1:
						d2 = d1
						d1 = d
						best = n
					elif d < d2:
						d2 = d
			var gap := sqrt(d2) - sqrt(d1)
			var c := leading if gap < lead else _shade(colors[best], 1.2 - sqrt(d1) / long_side * 2.4)
			_put(buf, y * size.x + x, c)


## Bands across the picture, warped by low-frequency noise; odd bands carry fine diagonal hatching.
static func _stripes(buf: PackedFloat32Array, size: Vector2i, rng: SeededRng, palette: Array[Color], warp: PackedByteArray) -> void:
	var long_side := float(maxi(size.x, size.y))
	var bands := 24
	var shades := PackedFloat32Array()
	for b in bands + 8:
		shades.append(rng.range_float(0.8, 1.1))
	var pitch := long_side / 120.0
	for y in size.y:
		for x in size.x:
			var i := y * size.x + x
			var t := (y / long_side + (warp[i] / 255.0 - 0.5) * 0.3) * bands
			var b := maxi(int(floorf(t)) + 4, 0)
			var shade := shades[b]
			if b % 2 == 1 and fmod((x + y) / pitch, 1.0) < 0.3:
				shade *= 0.8
			_put(buf, i, _shade(palette[b % 6], shade))


## Hundreds of overlapping discs and squares over a two-tone gradient.
static func _confetti(buf: PackedFloat32Array, size: Vector2i, rng: SeededRng, palette: Array[Color]) -> void:
	var long_side := float(maxi(size.x, size.y))
	var from := _shade(palette[1], 0.6)
	var to := _shade(palette[4], 0.6)
	for y in size.y:
		for x in size.x:
			_put(buf, y * size.x + x, from.lerp(to, (x + y) / float(size.x + size.y)))
	for s in 360:
		var cx := rng.range_float(0.0, 1.0) * size.x
		var cy := rng.range_float(0.0, 1.0) * size.y
		var r := rng.range_float(0.012, 0.045) * long_side
		var c := _shade(palette[rng.range_int(0, 5)], rng.range_float(0.85, 1.15))
		var is_disc := rng.next_float() < 0.5
		var angle := rng.range_float(0.0, PI)
		var cos_a := cos(angle)
		var sin_a := sin(angle)
		var reach := int(r * 1.5) + 1
		for y in range(maxi(int(cy) - reach, 0), mini(int(cy) + reach, size.y)):
			for x in range(maxi(int(cx) - reach, 0), mini(int(cx) + reach, size.x)):
				var dx := x - cx
				var dy := y - cy
				var inside: bool
				if is_disc:
					inside = dx * dx + dy * dy < r * r
				else:
					inside = absf(dx * cos_a + dy * sin_a) < r * 0.8 and absf(-dx * sin_a + dy * cos_a) < r * 0.8
				if inside:
					_put(buf, y * size.x + x, c)


## Triangles in a grid, each coloured by its position on a palette drift across the picture plus jitter.
static func _mosaic(buf: PackedFloat32Array, size: Vector2i, rng: SeededRng, palette: Array[Color]) -> void:
	var cols := 20
	var rows := ceili(size.y / float(size.x) * cols)
	var cw := float(size.x) / cols
	var ch := float(size.y) / rows
	var colors: Array[Color] = []
	for j in rows:
		for i in cols:
			for half in 2:
				var u := (i + 0.5 * half) / cols * 0.7 + float(j) / rows * 0.3
				var p := clampf(u * 5.0 + rng.range_float(-1.2, 1.2), 0.0, 5.0)
				var lo := int(p)
				var c := palette[lo].lerp(palette[mini(lo + 1, 5)], p - lo)
				colors.append(_shade(c, rng.range_float(0.75, 1.15)))
	for y in size.y:
		var j := mini(int(y / ch), rows - 1)
		var fy := y / ch - j
		for x in size.x:
			var i := mini(int(x / cw), cols - 1)
			var fx := x / cw - i
			var upper := fx + fy < 1.0 if (i + j) % 2 == 0 else fx > fy
			_put(buf, y * size.x + x, colors[(j * cols + i) * 2 + (0 if upper else 1)])


## Translucent vertical and horizontal bands crossing over a dark base, with a faint twill.
static func _plaid(buf: PackedFloat32Array, size: Vector2i, rng: SeededRng, palette: Array[Color]) -> void:
	var long_side := float(maxi(size.x, size.y))
	var columns := _bands(size.x, long_side, rng, palette)
	var rows := _bands(size.y, long_side, rng, palette)
	var base := _shade(palette[3], 0.55)
	var pitch := long_side / 200.0
	for y in size.y:
		var row: Color = rows[y]
		for x in size.x:
			var col: Color = columns[x]
			var c := base.lerp(Color(col.r, col.g, col.b), col.a)
			c = c.lerp(Color(row.r, row.g, row.b), row.a)
			if fmod((x + y) / pitch, 2.0) < 1.0:
				c = _shade(c, 0.93)
			_put(buf, y * size.x + x, c)


## One translucent colour per pixel along an axis; alpha is stored in the colour.
static func _bands(length: int, long_side: float, rng: SeededRng, palette: Array[Color]) -> Array[Color]:
	var result: Array[Color] = []
	while result.size() < length:
		var width := ceili(rng.range_float(0.02, 0.09) * long_side)
		var c := _shade(palette[rng.range_int(0, 5)], rng.range_float(0.85, 1.15))
		c.a = rng.range_float(0.45, 0.7)
		for k in mini(width, length - result.size()):
			result.append(c)
	return result
